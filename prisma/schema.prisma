generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ServicePriceType {
  FIXED
  FROM
}

// Forma do pagamento registrado (o SaaS não processa pagamento, só registra).
enum PaymentMethod {
  PIX
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  OTHER
}

model Business {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  timezone     String
  address      String?
  logoUrl      String?
  accentColor  String?   @default("#4F46E5")
  whatsapp     String?
  instagramUrl String?
  policyText   String?
  // Chave do preset de vertical (src/config/vertical.ts). String livre, não
  // enum: novos verticais não devem exigir migration.
  businessType String    @default("barbershop")
  coverUrl     String?

  // Políticas de reserva: valem para a página pública e o link do cliente;
  // o encaixe feito pelo painel não passa por elas.
  minBookingNoticeMinutes   Int @default(0)
  maxBookingWindowDays      Int @default(60)
  cancellationDeadlineHours Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users             User[]
  professionals     Professional[]
  services          Service[]
  serviceCategories ServiceCategory[]
  clients           Client[]
  appointments      Appointment[]
  payments          Payment[]
  workingHours      BusinessWorkingHours[]
  messageTemplates  MessageTemplate[]
  messageLogs       MessageLog[]

  @@index([deletedAt])
}

// Horário de funcionamento do negócio, só informativo (página pública). A
// disponibilidade continua vindo do expediente de cada profissional.
model BusinessWorkingHours {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday     Weekday
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, weekday])
}

enum MessageKind {
  CONFIRMATION
  REMINDER
  FOLLOW_UP
}

// Modelo de mensagem editado pelo dono. Sem registro, vale o padrão do código
// (src/server/modules/notification/whatsapp/templates.ts).
model MessageTemplate {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       MessageKind
  body       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([businessId, kind])
}

// Marca que uma mensagem foi enviada (hoje pelo WhatsApp do próprio dono, via wa.me).
model MessageLog {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  kind          MessageKind
  sentAt        DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([appointmentId, kind])
  @@index([businessId])
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(OWNER)
  // Incrementado em logout/troca de senha para invalidar de uma vez todos os
  // refresh tokens já emitidos, sem precisar de uma tabela de sessões.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
}

model Professional {
  id                String    @id @default(cuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  photoUrl          String?
  bio               String?
  specialty         String?
  // Chave da paleta de cores da agenda (src/lib/professional-colors.ts), nunca hex livre.
  color             String?
  // Comissão em % inteiro (0–100); null = sem comissão. Congelada em cada pagamento.
  commissionPercent Int?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  workingHours         WorkingHours[]
  timeBlocks           TimeBlock[]
  professionalServices ProfessionalService[]
  appointments         Appointment[]
  photos               ProfessionalPhoto[]

  @@index([businessId])
}

model ProfessionalPhoto {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  url            String
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([professionalId, position])
}

model WorkingHours {
  id               String       @id @default(cuid())
  professionalId   String
  professional     Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday          Weekday
  startMinute      Int
  endMinute        Int
  breakStartMinute Int?
  breakEndMinute   Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([professionalId, weekday])
  @@index([professionalId])
}

model Service {
  id            String           @id @default(cuid())
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  durationMin   Int
  priceCents    Int
  priceType     ServicePriceType @default(FIXED)
  position      Int              @default(0)
  visibleOnline Boolean          @default(true)
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  professionalServices ProfessionalService[]
  appointments         Appointment[]

  @@index([businessId])
  @@index([categoryId])
}

model ServiceCategory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  services Service[]

  @@unique([businessId, name])
  @@index([businessId])
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

model TimeBlock {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startAt        DateTime     @db.Timestamptz(6)
  endAt          DateTime     @db.Timestamptz(6)
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([professionalId, startAt, endAt])
}

model Client {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  // Só dígitos (normalizePhoneBR) — é a chave de deduplicação do cliente.
  phone         String
  email         String?
  internalNotes String?
  tags          String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments Appointment[]

  @@unique([businessId, phone])
  @@index([businessId])
}

model Appointment {
  id                   String            @id @default(cuid())
  businessId           String
  business             Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionalId       String
  professional         Professional      @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  serviceId            String
  service              Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clientId             String
  client               Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  startAt              DateTime          @db.Timestamptz(6)
  endAt                DateTime          @db.Timestamptz(6)
  status               AppointmentStatus @default(PENDING)
  manageToken          String            @unique @default(uuid())
  manageTokenExpiresAt DateTime?         @db.Timestamptz(6)
  notes                String?
  // Valor do atendimento em centavos: nasce com o preço do serviço na marcação
  // (editar o serviço depois não reescreve o passado) e pode ser ajustado ao
  // receber (ex.: serviço "a partir de").
  priceCents           Int
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  review      Review?
  payments    Payment[]
  messageLogs MessageLog[]

  @@index([businessId, startAt])
  @@index([professionalId, startAt, endAt])
}

// Recebimento registrado de um atendimento (1:N — sinal + saldo, formas
// diferentes). Status pendente/parcial/pago é derivado, nunca gravado.
model Payment {
  id                String        @id @default(cuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId     String
  appointment       Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  // Quanto entrou de fato (centavos) e desconto concedido (centavos).
  amountCents       Int
  discountCents     Int           @default(0)
  method            PaymentMethod
  // Data que vale para o financeiro e as comissões.
  receivedAt        DateTime      @db.Timestamptz(6)
  note              String?
  // % de comissão do profissional congelada no momento do registro.
  commissionPercent Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  @@index([businessId, receivedAt])
  @@index([appointmentId])
}

model Review {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
}
