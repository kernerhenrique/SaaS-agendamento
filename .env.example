# Postgres local via docker-compose (docker compose up -d)
DATABASE_URL="postgresql://agendamento:agendamento@localhost:5432/agendamento?schema=public"

# Gere um valor próprio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio-de-32-bytes-em-hexadecimal"

# Envio de e-mail (opcional; sem isso o e-mail só aparece no console).
# SMTP do domínio (Hostinger: smtp.hostinger.com, porta 465). O cliente vê o
# nome do negócio no "De:"; o endereço é sempre EMAIL_FROM.
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_USER="nao-responda@aprazzo.com.br"
# SMTP_PASS="senha-da-caixa"
# EMAIL_FROM="nao-responda@aprazzo.com.br"
# Alternativa antiga: Gmail + senha de app (myaccount.google.com/apppasswords)
# GMAIL_USER="seuemail@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

APP_BASE_URL="http://localhost:3000"

# Produção (Vercel + Neon): ver docs/publicacao.md. As variáveis ficam no painel
# da Vercel, nunca neste arquivo nem no git.
# DATABASE_URL          -> string "pooled" do Neon (com -pooler no host), usada pelo app
# DATABASE_URL_UNPOOLED -> string direta do Neon, usada só pelo `prisma migrate deploy` no build
# APP_BASE_URL          -> https://aprazzo.com.br
